# Copy to api/.env for local development. Every setting can also be passed as an environment variable.
ROLLFIX_DATABASE_URL=postgresql://rollfix:rollfix@localhost:5432/rollfix
# Web origins allowed to call the API, comma-separated.
ROLLFIX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Groups smaller than this are never published.
ROLLFIX_MIN_GROUP_SIZE=5
# Shares, updates and removals allowed per client per hour.
ROLLFIX_WRITE_LIMIT_PER_HOUR=30
# Only behind a reverse proxy you control: rate-limit by X-Forwarded-For.
ROLLFIX_TRUST_PROXY=false
ROLLFIX_STATS_CACHE_SECONDS=60
