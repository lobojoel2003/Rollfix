{
	"$id": "https://lobojoel2003.github.io/Rollfix/schema/holidays.schema.json",
	"title": "Rollfix holiday calendar",
	"description": "Schema for rules/holidays/*.yaml. Generated from src/lib/engine/schema.ts; do not edit by hand.",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schema_version": {
			"type": "number",
			"const": 1
		},
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"holidays": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
					},
					"name": {
						"type": "string",
						"minLength": 1
					},
					"date": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"month": {
										"type": "integer",
										"minimum": 1,
										"maximum": 12
									},
									"day": {
										"type": "integer",
										"minimum": 1,
										"maximum": 31
									},
									"observed": {
										"type": "string",
										"enum": [
											"none",
											"nearest_weekday",
											"sunday_to_monday"
										]
									}
								},
								"required": [
									"month",
									"day"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"month": {
										"type": "integer",
										"minimum": 1,
										"maximum": 12
									},
									"weekday": {
										"type": "string",
										"enum": [
											"sun",
											"mon",
											"tue",
											"wed",
											"thu",
											"fri",
											"sat"
										]
									},
									"nth": {
										"type": "integer",
										"minimum": -1,
										"maximum": 5
									},
									"offset_days": {
										"type": "integer",
										"minimum": -9007199254740991,
										"maximum": 9007199254740991
									}
								},
								"required": [
									"month",
									"weekday",
									"nth"
								],
								"additionalProperties": false
							}
						]
					},
					"since": {
						"type": "integer",
						"minimum": 1900,
						"maximum": 9007199254740991
					},
					"until": {
						"type": "integer",
						"minimum": 1900,
						"maximum": 9007199254740991
					}
				},
				"required": [
					"id",
					"name",
					"date"
				],
				"additionalProperties": false
			}
		},
		"sources": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string",
						"minLength": 1
					},
					"url": {
						"type": "string",
						"format": "uri"
					}
				},
				"required": [
					"label",
					"url"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"schema_version",
		"id",
		"name",
		"holidays",
		"sources"
	],
	"additionalProperties": false
}
